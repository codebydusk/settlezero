<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".SettleZeroApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.SettleZero">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SettleZero">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom URI Scheme: settlezero://invite/{token} & settlezero://join/{token} -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="settlezero" android:host="invite" />
                <data android:scheme="settlezero" android:host="join" />
            </intent-filter>

            <!-- App Links: https://settlezero.app/join/{token} & https://settlezero.app/invite/{token} -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="settlezero.app" android:pathPrefix="/join" />
                <data android:scheme="https" android:host="settlezero.app" android:pathPrefix="/invite" />
            </intent-filter>
        </activity>
    </application>

</manifest>

