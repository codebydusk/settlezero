.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.tmp
*.swp
*.bak
*.log

# IDEs
.idea/
.vscode/
*.iml
*.iws
*.ipr
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# --- Android & Gradle ---
.gradle/
build/
*/build/
bin/
*/bin/

# Local Android SDK configuration
local.properties

# Android build outputs & bundles
*.apk
*.ap_
*.aab
captures/
.externalNativeBuild/
.cxx/
output-metadata.json

# Android Profiling & dumps
*.hprof

# Keystore signing keys
*.jks
*.keystore

# Google Services credentials
google-services.json

# --- Web Frontend (Node / Vite / React / TypeScript) ---
node_modules/
*/node_modules/
dist/
*/dist/
.vite/
*/.vite/
*.tsbuildinfo
.eslintcache

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variable overrides
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# --- Backend (Go & SQLite) ---
backend/bin/
backend/.gocache/
*.exe
*.test
*.out
cover.out
coverage.html

# Local SQLite databases, journals, WAL, and locks
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Testing & ADB Device Dumps ---
*_dump.xml
dash.xml
